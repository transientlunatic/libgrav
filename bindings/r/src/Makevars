# src/Makevars
#
# Build configuration for the libgrav R package.
#
# The package links against libgrav — the cdylib built by the
# bindings/julia Rust crate.  Build it first:
#
#   cargo build --release -p grav-capi
#
# Then install the R package from the monorepo root:
#
#   R CMD INSTALL bindings/r
#
# To override the library location (e.g. after `cargo install` or when the
# monorepo is not at the expected relative path), set GRAV_LIB:
#
#   GRAV_LIB=/opt/libgrav/lib R CMD INSTALL bindings/r

ifdef GRAV_LIB
  _GRAV_LIB := $(GRAV_LIB)
else
  # Default: monorepo layout — src/ is three levels below the repo root.
  _GRAV_LIB := $(abspath ../../../target/release)
endif

_GRAV_INCLUDE := $(abspath ../../../bindings/julia/include)

PKG_CPPFLAGS = -I$(_GRAV_INCLUDE)
PKG_LIBS     = -L$(_GRAV_LIB) -lgrav -Wl,-rpath,$(_GRAV_LIB)
