# src/Makevars
#
# By default the Rust code in src/rust (vendored by scripts/vendor_r.py) is
# compiled with cargo at install time and linked statically into libgrav.so, so
# `R CMD INSTALL` / install.packages() need only a Rust toolchain (cargo, rustc).
#
# To link against a prebuilt shared libgrav instead (e.g. the one from a
# release tarball or `cargo build --release -p grav-capi`), set GRAV_LIB:
#
#   GRAV_LIB=/opt/libgrav/lib R CMD INSTALL bindings/r

ifdef GRAV_LIB
  PKG_CPPFLAGS = -Irust
  PKG_LIBS     = -L$(GRAV_LIB) -lgrav -Wl,-rpath,$(GRAV_LIB)
else
  PKG_CPPFLAGS = -Irust
  PKG_LIBS     = $(RUST_LIB) -lpthread -ldl -lm

  RUST_TARGET_DIR = $(CURDIR)/rust/target
  RUST_LIB        = $(RUST_TARGET_DIR)/release/libgrav.a

  $(SHLIB): $(RUST_LIB)

  $(RUST_LIB):
	cargo build --release --manifest-path rust/Cargo.toml -p grav-capi \
	  --target-dir $(RUST_TARGET_DIR)
endif

clean:
	rm -rf rust/target
