# src/Makevars
#
# By default the Rust code in src/rust (vendored by scripts/vendor_r.py) is
# compiled with cargo at install time and linked statically into Puddin.so, so
# `R CMD INSTALL` / install.packages() need only a Rust toolchain (cargo, rustc).
#
# To link against a prebuilt shared libpuddin_julia instead (e.g. the one from a
# release tarball or `cargo build --release -p puddin-julia`), set PUDDIN_LIB:
#
#   PUDDIN_LIB=/opt/puddin/lib R CMD INSTALL bindings/r

ifdef PUDDIN_LIB
  PKG_CPPFLAGS = -Irust
  PKG_LIBS     = -L$(PUDDIN_LIB) -lpuddin_julia -Wl,-rpath,$(PUDDIN_LIB)
else
  PKG_CPPFLAGS = -Irust
  PKG_LIBS     = $(RUST_LIB) -lpthread -ldl -lm

  RUST_TARGET_DIR = $(CURDIR)/rust/target
  RUST_LIB        = $(RUST_TARGET_DIR)/release/libpuddin_julia.a

  $(SHLIB): $(RUST_LIB)

  $(RUST_LIB):
	cargo build --release --manifest-path rust/Cargo.toml -p puddin-julia \
	  --target-dir $(RUST_TARGET_DIR)
endif

clean:
	rm -rf rust/target
